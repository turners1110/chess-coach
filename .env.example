# Copy to .env (never commit .env). Secrets live only here (spec §29).
POSTGRES_PASSWORD=change-me
# argon2id hash of your app password, in single quotes: docker compose run --rm api python -m coach.passwd
COACH_PASSWORD_HASH=''
# Analysis processes: one per spare CPU core
COACH_WORKERS=2
# Only if the app is hosted elsewhere (for example on Vercel): its address
COACH_ALLOWED_ORIGINS=
